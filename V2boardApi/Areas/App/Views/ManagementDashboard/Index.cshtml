@{
    ViewBag.Title = "داشبورد مدیریت";
}

@section vendorStyle {
    <style>
        .mgmt-amounts-hidden .js-mgmt-amount {
            filter: blur(8px);
            user-select: none;
            pointer-events: none;
        }

        .mgmt-amounts-hidden .js-mgmt-amount-chart {
            filter: blur(14px);
            pointer-events: none;
            user-select: none;
        }
    </style>
}

<div class="row section-loading" id="mgmtOverview">
</div>

@section vendorScripts {
    <script src="../../assets/vendor/libs/apex-charts/apexcharts.js"></script>
    <script src="../../assets/vendor/libs/block-ui/block-ui.js"></script>
}

@section customScripts {
    <script src="@PanelAssetHelper.Js("../../assets/js/app-management-dashboard.js")"></script>
    <script>
        $(function () {
            $.ajax({
                url: "@Url.Action("GetOverview", "ManagementDashboard", new { area = "App" })",
                type: "get",
                dataType: "html",
                beforeSend: function () {
                    blockUI(".section-loading");
                },
                success: function (res) {
                    UnblockUI(".section-loading");
                    $("#mgmtOverview").html(res);
                    if (window.ManagementDashboard && typeof window.ManagementDashboard.loadCharts === "function") {
                        window.ManagementDashboard.loadCharts();
                    }
                },
                error: function () {
                    UnblockUI(".section-loading");
                }
            });
        });
    </script>
}
