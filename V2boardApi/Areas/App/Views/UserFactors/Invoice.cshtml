@model V2boardApi.Models.UserInvoiceViewModel
@{
    ViewBag.Title = "Invoice";
    Layout = null;


}

<!DOCTYPE html>
<html lang="fa" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:v="urn:schemas-microsoft-com:vml">
<head>
    <meta charset="utf-8">
    <meta name="x-apple-disable-message-reformatting">
    <meta content="ie=edge" http-equiv="x-ua-compatible">
    <meta content="width=device-width, initial-scale=1" name="viewport">
    <meta content="telephone=no, date=no, address=no, email=no" name="format-detection">
    <!--[if mso]>
    <xml>
        <o:officedocumentsettings>
            <o:pixelsperinch>96</o:pixelsperinch>
        </o:officedocumentsettings>
    </xml><![endif]-->
    <link href="~/assets/fonts/farsi-fonts/font.css" media="screen" rel="stylesheet">
    <link href="~/assets/css/Invoice.css" media="screen" rel="stylesheet">
    <style>
        .hover-underline:hover {
            text-decoration: underline !important;
        }


    </style>
</head>
<body style="margin: 0; width: 100%; padding: 0; word-break: break-word; -webkit-font-smoothing: antialiased;direction: rtl; font-family: font-primary , 'tahoma', serif ;">
    <div style="font-family: font-primary, sans-serif; mso-line-height-rule: exactly; display: none;">این یک فاکتور برای خرید شما در حالت تعریف نشده است. لطفا پرداخت را با تعریف نشده ارسال کنید</div>
    <div aria-label="" aria-roledescription="email" lang="fa" role="article" style="font-family: font-primary, sans-serif; mso-line-height-rule: exactly;">
        <table cellpadding="0" cellspacing="0" role="presentation" style="width: 100%; font-family: Montserrat, -apple-system, 'Segoe UI', sans-serif;">
            <tr>

                <td align="center" style="mso-line-height-rule: exactly; background-color: #eceff1; font-family: Montserrat, -apple-system, 'Segoe UI', sans-serif;">
                    @if (Model.PayStatus)
                    {
                        <div class="statuspay" style=" position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%) rotate(-20deg); font-size: 90px; font-weight: bold; color: #00b00e; opacity: 0.20; z-index: 1; white-space: nowrap; pointer-events: none; font-family: font-demi-bold; ">
                            پرداخت شده
                        </div>
                    }
                    else
                    {
                        <div class="statuspay" style=" position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%) rotate(-20deg); font-size: 90px; font-weight: bold; color: #e90000; opacity: 0.20; z-index: 1; white-space: nowrap; pointer-events: none; font-family: font-demi-bold; ">
                            پرداخت نشده
                        </div>
                    }
                    <table cellpadding="0" cellspacing="0" class="sm-w-full" role="presentation" style="width: 600px;">
                        <tr>
                            <td class="sm-py-32 sm-px-24" style="mso-line-height-rule: exactly; padding: 48px; text-align: center; font-family: Montserrat, -apple-system, 'Segoe UI', sans-serif;">
                            </td>
                        </tr>
                        <tr>
                            <td align="center" class="sm-px-24" style="font-family: font-primary, sans-serif; mso-line-height-rule: exactly;">
                                <table cellpadding="0" cellspacing="0" role="presentation" style="width: 100%;">
                                    <tr>
                                        <td class="sm-px-24" style="mso-line-height-rule: exactly; border-radius: 4px; background-color: #ffffff; padding: 48px; text-align: right; font-family: Montserrat, -apple-system, 'Segoe UI', sans-serif; font-size: 16px; line-height: 24px; color: #626262;">
                                            <p style="font-family: font-demi-bold, sans-serif; mso-line-height-rule: exactly; margin-bottom: 0; font-size: 20px; text-align: left; color: #7367f0">#@Model.invoice_id</p>
                                            <p style="font-family: font-demi-bold, sans-serif; mso-line-height-rule: exactly; margin-bottom: 0; font-size: 20px;">سلام</p>
                                            <p style="font-family: font-demi-bold, sans-serif; mso-line-height-rule: exactly; margin-top: 10px; font-size: 24px; color: #ff5850;">@Model.FullName </p>
                                            <p style="font-family: font-bold, sans-serif;mso-line-height-rule: exactly; margin: 0; margin-bottom: 24px;">
                                                تشکر بابت اعتماد به ما ، لطفا فاکتور را پرداخت کنید.
                                            </p>
                                            <table cellpadding="0" cellspacing="0" role="presentation" style="width: 100%;">
                                                <tr>
                                                    <td style="font-family: font-primary, sans-serif; mso-line-height-rule: exactly; font-size: 16px;">
                                                        <table cellpadding="0" cellspacing="0" role="presentation" style="width: 100%;">
                                                            <tr>
                                                                <td style="font-family: font-primary, sans-serif; mso-line-height-rule: exactly; font-size: 16px;">
                                                                    <span style="font-family: font-bold, sans-serif;">مبلغ:</span>
                                                                    @Model.PayAmount ریال
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td style="font-family: font-primary, sans-serif; mso-line-height-rule: exactly; font-size: 16px;">
                                                                    <span style="font-family: font-bold, sans-serif;">تاریخ:</span>
                                                                    @Model.Date
                                                                </td>
                                                            </tr>
                                                        </table>
                                                    </td>
                                                </tr>
                                            </table>
                                            <table cellpadding="0" cellspacing="0" role="presentation" style="width: 100%;margin-top: 30px">
                                                <tr>
                                                    <td colspan="2" style="font-family: font-primary, sans-serif; mso-line-height-rule: exactly;">
                                                        <table cellpadding="0" cellspacing="0" role="presentation" style="width: 100%;">
                                                            <tr>
                                                                <th align="right" style="font-family: font-primary, sans-serif; mso-line-height-rule: exactly; padding-bottom: 8px;">
                                                                    <p style="font-family: font-demi-bold, sans-serif; mso-line-height-rule: exactly;">توضیحات</p>
                                                                </th>
                                                                <th align="right" style="font-family: font-primary, sans-serif; mso-line-height-rule: exactly; padding-bottom: 8px;">
                                                                    <p style="font-family: font-demi-bold, sans-serif; mso-line-height-rule: exactly;">مبلغ</p>
                                                                </th>
                                                            </tr>

                                                            <tr>
                                                                <td style="font-family: font-primary, sans-serif; mso-line-height-rule: exactly; width: 80%; padding-top: 10px; padding-bottom: 10px; font-size: 16px;">
                                                                    @Model.Desc
                                                                </td>
                                                                <td align="right" style="font-family: font-bold, sans-serif; mso-line-height-rule: exactly; width: 20%; text-align: right; font-size: 16px;">@Model.PayAmount ریال</td>
                                                            </tr>
                                                        </table>
                                                    </td>
                                                </tr>
                                            </table>
                                            <table cellpadding="0" cellspacing="0" role="presentation"
                                                   style="width:100%;margin-top:30px;background:#f8f9fa;border:1px solid #e5e5e5;border-radius:6px;">
                                                <tr>
                                                    <td style="padding: 20px; font-family: font-demi-bold ">
                                                        <p style="margin: 0 0 15px 0; font-family: font-demi-bold; font-size: 18px; color: #333;">
                                                            اطلاعات پرداخت
                                                        </p>

                                                        <p style="margin:8px 0;">
                                                            <strong>نام صاحب کارت:</strong>
                                                            @Model.Card_FullName
                                                        </p>
                                                        <hr />
                                                        <p style="margin:8px 0;">
                                                            <strong>شماره کارت:</strong>
                                                            <span dir="ltr" style="font-family: font-demi-bold; font-weight: bold;">
                                                                @Model.Card_Number
                                                            </span>
                                                        </p>
                                                        <hr />
                                                        <p style="margin:8px 0;">
                                                            <strong>مبلغ قابل پرداخت:</strong>
                                                            <span style="color:#ff5850;font-weight:bold;">
                                                                @Model.PayAmount ریال
                                                            </span>
                                                        </p>
                                                        <hr />
                                                        <p style="margin-top:15px;color:#666;">
                                                            ⚠️ جهت تأیید خودکار پرداخت، مبلغ را دقیق به شماره کارت فوق واریز نمایید. واریز مبالغ کمتر یا بیشتر ممکن است باعث عدم شناسایی خودکار پرداخت شود.
                                                        </p>
                                                    </td>
                                                </tr>
                                            </table>

                                            <p style="font-family: font-primary, sans-serif; mso-line-height-rule: exactly; margin: 0; margin-bottom: 16px;">


                                            </p>

                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td style="font-family: font-primary, sans-serif; mso-line-height-rule: exactly; height: 20px;"></td>
                        </tr>
                        <tr>
                            <td style="mso-line-height-rule: exactly; padding-left: 48px; padding-right: 48px; font-family: Montserrat, -apple-system, 'Segoe UI', sans-serif; font-size: 14px; color: #eceff1;">
                            </td>
                        </tr>
                        <tr>
                            <td style="font-family: font-primary, sans-serif; mso-line-height-rule: exactly; height: 16px;"></td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </div>
</body>
</html>


