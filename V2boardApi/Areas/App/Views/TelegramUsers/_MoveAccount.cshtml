@model List<DataLayer.DomainModel.tbTelegramUsers>
<form class="form-sample" id="legacyMoveAccountForm" method="post">
    <div class="modal-content">
        <div class="modal-body">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">انتقال اشتراک</h4>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="linkId" value="@ViewBag.LinkID" />
                    <div class="form-group">
                        <select class="form-control-sm" id="TelUsers" name="targetTelUserId">
                            @foreach (var item in Model)
                            {
                                var fullName = ((item.Tel_FirstName ?? "") + " " + (item.Tel_LastName ?? "")).Trim();
                                var label = string.IsNullOrEmpty(fullName)
                                    ? item.Tel_Username
                                    : fullName + " (" + item.Tel_Username + ")";
                                <option value="@item.Tel_UserID">@label</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-dark close" data-bs-dismiss="modal">بستن</button>
            <button type="submit" class="btn btn-success">انتقال</button>
        </div>
    </div>
</form>

<script>
    $(".close").click(function () {
        $('.modal').modal('hide');
    });

    $(document).ready(function () {
        $('#TelUsers').select2({
            dropdownParent: $('.modal-content'),
            width: '75%',
            placeholder: 'انتخاب مشترک'
        });

        $('#legacyMoveAccountForm').on('submit', function (e) {
            e.preventDefault();
            $.ajax({
                url: '@Url.Action("MoveAccount", "TelegramUsers", new { area = "App" })',
                type: 'POST',
                data: $(this).serialize(),
                success: function (res) {
                    eval(res.data);
                    if (res.status === 'success') {
                        $('.modal').modal('hide');
                        location.reload();
                    }
                }
            });
        });
    });
</script>
