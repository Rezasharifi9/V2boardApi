@model DataLayer.DomainModel.tbUsers
@{
    var daysAfterPayment = Model.Settlement_DayOfMonth ?? 15;
    var preWarningDays = Model.Settlement_DayOfWeek ?? 2;
    var blockGraceDays = Model.Settlement_BlockGraceDays ?? 2;
}

<form class="row g-3" id="settlementSettingForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="user_id" value="@Model.User_ID" />

    <div class="col-12">
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" id="settlementEnabled" name="settlementEnabled" value="true"
                   @(Model.Settlement_Enabled ? "checked" : "") />
            <label class="form-check-label" for="settlementEnabled">فعال‌سازی تسویه بدهی</label>
        </div>
        <small class="text-muted d-block mt-1">
            مهلت تسویه از <strong>آخرین فاکتور پرداخت‌شده</strong> محاسبه می‌شود. در صورت عدم پرداخت، اشتراک‌های زیرمجموعه (و زیرنمایندگان در صورت نماینده کل) مسدود می‌شوند.
        </small>
    </div>

    <div class="col-12 col-md-4">
        <label class="form-label" for="settlementDaysAfterPayment">مهلت تسویه (روز پس از آخرین پرداخت)</label>
        <input class="form-control" type="number" min="1" max="365" id="settlementDaysAfterPayment"
               name="settlementDaysAfterPayment" value="@daysAfterPayment" />
        <small class="text-muted">مثلاً ۱۵ یعنی ۱۵ روز بعد از آخرین فاکتور پرداختی، موعد تسویه فرا می‌رسد.</small>
    </div>

    <div class="col-12 col-md-4">
        <label class="form-label" for="settlementPreWarningDays">هشدار قبل از موعد (روز)</label>
        <input class="form-control" type="number" min="0" max="30" id="settlementPreWarningDays"
               name="settlementPreWarningDays" value="@preWarningDays" />
        <small class="text-muted">مثلاً ۲ یعنی دو روز قبل از موعد، هشدار تلگرام ارسال شود.</small>
    </div>

    <div class="col-12 col-md-4">
        <label class="form-label" for="settlementBlockGraceDays">مهلت قبل از مسدودسازی (روز پس از موعد)</label>
        <input class="form-control" type="number" min="0" max="30" id="settlementBlockGraceDays"
               name="settlementBlockGraceDays" value="@blockGraceDays" />
        <small class="text-muted">مثلاً ۲ یعنی دو روز بعد از موعد تسویه، اشتراک‌ها مسدود شوند.</small>
    </div>

    <div class="col-12">
        <div class="alert alert-secondary mb-0">
            <strong>جریان کار:</strong>
            <ul class="mb-0 mt-2 small">
                <li>هشدار قبل از موعد → پیام روز سررسید → هر ۶ ساعت پس از موعد تا زمان مسدودسازی</li>
                <li>پس از مسدودسازی، با ثبت پرداخت فاکتور، اشتراک‌ها فعال و مهلت از همان روز پرداخت دوباره شروع می‌شود.</li>
            </ul>
        </div>
    </div>

    <div class="col-12">
        <button type="button" class="btn btn-primary" id="saveSettlementSetting">ذخیره تنظیمات تسویه</button>
    </div>
</form>
