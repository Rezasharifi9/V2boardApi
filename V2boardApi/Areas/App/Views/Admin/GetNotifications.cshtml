@model List<DataLayer.DomainModel.tbNotificationUser>
@using V2boardApi.Tools

@if (Model.Count == 0)
{
    <li class="list-group-item text-center text-muted py-4">
        <i class="ti ti-bell-off mb-2 d-block" style="font-size:22px;"></i>
        اطلاعیه‌ای وجود ندارد
    </li>
}

@foreach (var item in Model)
{
    var title = item.tbNotifications.tbNoti_Title;
    <li class="list-group-item list-group-item-action dropdown-notifications-item @(item.tbNotiUser_Seen ? "" : "marked-as-read")">
        <div class="d-flex">
            <div class="flex-shrink-0 me-3">
                <div class="avatar">
                    <span class="avatar-initial rounded-circle @PanelNotificationService.GetColorClass(title)">
                        <i class="@PanelNotificationService.GetIconClass(title)"></i>
                    </span>
                </div>
            </div>
            <div class="flex-grow-1">
                <h6 class="mb-1">@title</h6>
                <p class="mb-1" style="white-space:pre-line;">@item.tbNotifications.tbNoti_Text</p>
                <small class="text-muted">@Utility.GetTimeDifference(item.tbNotifications.tbNoti_RegisterDate, DateTime.Now)</small>
            </div>
            <div class="flex-shrink-0 dropdown-notifications-actions">
                <a class="dropdown-notifications-archive" href="javascript:void(0)" onclick="DeleteNotif('@item.tbNotiUser_ID')">
                    <span class="ti ti-x"></span>
                </a>
            </div>
        </div>

    </li>
}
