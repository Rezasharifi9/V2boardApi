@section vendorStyle {
    <link rel="stylesheet" href="../../assets/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
    <link rel="stylesheet" href="../../assets/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.css" />
    <link rel="stylesheet" href="../../assets/vendor/libs/datatables-buttons-bs5/buttons.bootstrap5.css" />
    <link rel="stylesheet" href="../../assets/vendor/libs/select2/select2.css" />
    <link rel="stylesheet" href="@Url.Content("~/assets/vendor/libs/@form-validation/form-validation.css")" />
    <link rel="stylesheet" href="../../assets/vendor/libs/sweetalert2/sweetalert2.css" />
    <style>
        #cardOverdueDebt { cursor: pointer; transition: box-shadow .15s ease; }
        #cardOverdueDebt:hover { box-shadow: 0 .25rem .9rem rgba(255, 62, 29, .18); }
    </style>
}

<h4 class="py-3 mb-4">
    نمایندگان
</h4>

<div class="row g-4 mb-4" id="agentSummaryCards">
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100" id="cardOverdueDebt" role="button" title="برای مشاهده جزئیات کلیک کنید">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between">
                    <div class="content-left">
                        <span>بدهی بیش از یک ماه</span>
                        <div class="d-flex align-items-center my-2">
                            <h3 class="mb-0 me-2" id="statOverdueCount">—</h3>
                        </div>
                        <p class="mb-0 text-muted">پرداخت‌نشده — برای جزئیات کلیک کنید</p>
                    </div>
                    <div class="avatar"> <span class="avatar-initial rounded bg-label-danger"> <i class="ti ti-alert-triangle ti-sm"></i> </span> </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between">
                    <div class="content-left">
                        <span>مجموع بدهی</span>
                        <div class="d-flex align-items-center my-2">
                            <h3 class="mb-0 me-2" id="statTotalDebt">—</h3>
                        </div>
                        <p class="mb-0 text-muted">تومان بدهی جاری نمایندگان</p>
                    </div>
                    <div class="avatar"> <span class="avatar-initial rounded bg-label-warning"> <i class="ti ti-cash ti-sm"></i> </span> </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between">
                    <div class="content-left">
                        <span>اشتراک مسدود</span>
                        <div class="d-flex align-items-center my-2">
                            <h3 class="mb-0 me-2" id="statBlockedCount">—</h3>
                        </div>
                        <p class="mb-0 text-muted">نمایندگان با اشتراک مسدودشده</p>
                    </div>
                    <div class="avatar"> <span class="avatar-initial rounded bg-label-secondary"> <i class="ti ti-lock ti-sm"></i> </span> </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between">
                    <div class="content-left">
                        <span>بدون تلگرام فعال</span>
                        <div class="d-flex align-items-center my-2">
                            <h3 class="mb-0 me-2" id="statNoTelegramCount">—</h3>
                        </div>
                        <p class="mb-0 text-muted">حساب تلگرام در ربات ثبت نشده</p>
                    </div>
                    <div class="avatar"> <span class="avatar-initial rounded bg-label-info"> <i class="ti ti-send ti-sm"></i> </span> </div>
                </div>
            </div>
        </div>
    </div>
</div>

@{
    var isSystemAdmin = (ViewBag.UserRole as string) == "1";
    var headAgents = ViewBag.HeadAgents as IEnumerable<V2boardApi.Areas.App.Data.UsersViewModels.SelectUserViewModel>;
}
@if (isSystemAdmin)
{
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label" for="filterHeadAgentSelect">نماینده کل</label>
                    <select id="filterHeadAgentSelect" class="form-select">
                        <option value="">نمایندگان مستقیم</option>
                        @if (headAgents != null)
                        {
                            foreach (var agent in headAgents)
                            {
                                <option value="@agent.id">@agent.username</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-8">
                    <p class="text-muted mb-0">با انتخاب نماینده کل، نمایندگان زیرمجموعه او در جدول نمایش داده می‌شوند.</p>
                </div>
            </div>
        </div>
    </div>
}

<!-- Users List Table -->

<div class="card">
    @*<div class="card-header border-bottom">
            <h5 class="card-title mb-3">فیلتر جستجو</h5>
            <div class="d-flex justify-content-between align-items-center row pb-2 gap-3 gap-md-0 mt-3">
                <div class="col-md-4 user_role"></div>
                <div class="col-md-4 user_plan"></div>
                <div class="col-md-4 user_status"></div>
            </div>
        </div>*@
    <div class="card-datatable table-responsive">
        <table class="datatables-users table">
            <thead class="border-top">
                <tr>
                    <th></th>
                    <th>نام کاربری</th>
                    <th>بدهی</th>
                    <th>محدودیت</th>
                    <th>وضعیت</th>
                    <th>تلگرام</th>
                    <th>آخرین پرداختی</th>
                    <th>تعداد فروش</th>
                    <th>مجموع فروش</th>
                    <th>عملیات</th>
                </tr>
            </thead>
        </table>
    </div>
    <!-- Offcanvas to add new user -->
    <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasAddUser" aria-labelledby="offcanvasAddUserLabel">
        <div class="offcanvas-header">
            <h5 id="offcanvasAddUserLabel" class="offcanvas-title">اطلاعات کاربر</h5>
            <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="بستن"></button>
        </div>
        <div class="offcanvas-body mx-0 flex-grow-0 pt-0 h-100">
            <form class="add-new-user pt-0" id="addNewUserForm">
                @Html.AntiForgeryToken()

                <input type="hidden" value="0" name="userId" />
                <div class="mb-3">
                    <label class="form-label" for="add-user-company">نام کاربری <span class="text-danger"> * </span></label>
                    <input type="text" id="add-user-username" class="form-control" placeholder="" aria-label=""
                           name="userUsername" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="add-user-contact">محدودیت<span class="text-danger"> * </span></label>
                    <input type="text" id="userLimit" class="form-control" placeholder=""
                           aria-label="3,000,000 تومان" name="userLimit" onkeyup="separateDigits(this)" />
                </div>
                @*<div class="mb-3">
                        <label class="form-label" for="userPlan">تعرفه<span class="text-danger"> * </span></label>
                        <select id="userPlan" class="select2 form-select" multiple autocomplete="off" name="userPlan">
                            <option value="">انتخاب کنید</option>
                        </select>
                        <div id="userPlanMessage" class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback d-none"><div data-field="userLimit" data-validator="notEmpty">تعرفه را وارد کنید</div></div>

                    </div>*@

                <div class="mb-3">
                    <label class="form-label" for="add-user-fullname">رمز عبور<span class="text-danger"> * </span></label>
                    <input type="text" class="form-control" id="add-user-password" placeholder="" name="userPassword"
                           aria-label="******" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="add-user-fullname">نام و نام خانوادگی</label>
                    <input type="text" class="form-control" id="add-user-fullname" placeholder="" name="userFullname"
                           aria-label="نـوید" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="add-user-email">ایمیل</label>
                    <input type="text" id="add-user-email" class="form-control" placeholder="" aria-label=""
                           name="userEmail" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="add-user-contact">شماره موبایل</label>
                    <input type="text" id="add-user-contact" class="form-control phone-mask bdi" placeholder=""
                           aria-label="john.doe@example.com" name="userContact" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="add-user-telegramid">آیدی تلگرام</label>
                    <input type="text" id="add-user-telegramid" class="form-control" placeholder="" aria-label=""
                           name="userTelegramid" />
                </div>

                <button type="submit" class="btn btn-primary me-sm-3 me-1 data-submit">ارسال</button>
                <button type="reset" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">لغو</button>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="modalSendAgentMessage" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">ارسال پیام به <span id="sendAgentMessageName"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                <label class="form-label" for="sendAgentMessageText">متن پیام</label>
                <textarea class="form-control" id="sendAgentMessageText" rows="6" placeholder="پیام در پنل و ربات تلگرام نماینده ارسال می‌شود"></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-primary" id="btnSendAgentMessage">ارسال به پنل و ربات</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalOverdueDebt" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">بدهی‌های پرداخت‌نشده بیش از یک ماه</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>نام کاربری</th>
                                <th>بدهی</th>
                                <th>آخرین پرداختی</th>
                                <th>مدت بدون پرداخت</th>
                            </tr>
                        </thead>
                        <tbody id="overdueDebtBody"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@if (isSystemAdmin)
{
    <div aria-hidden="true" class="modal fade" id="editWallet" tabindex="-1">
        <div class="modal-dialog modal-lg modal-simple modal-edit-user">
            <div class="modal-content p-3 p-md-5">
                <div class="modal-body">
                    <button aria-label="بستن" class="btn-close" data-bs-dismiss="modal" type="button"></button>
                    <div class="text-center mb-4">
                        <h3 class="mb-2">تغییر مبلغ کیف پول</h3>
                        <p class="text-muted mb-0" id="editWalletAgentName"></p>
                    </div>
                    <form class="row g-3" id="editWalletForm" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" value="" name="user_id" id="editWalletUserId" />
                        <div class="col-12 d-flex align-items-center justify-content-between">
                            <div class="flex-grow-1 me-2">
                                <label class="form-label" for="Deposit">بدهی / کیف پول</label>
                                <input class="form-control" id="Deposit" name="userDeposit" placeholder="3,000,000" type="text" onkeyup="separateDigits(this)" value="" />
                            </div>
                            <div class="text-center">
                                <label class="form-label d-block">&nbsp;</label>
                                <button class="btn btn-label-info" id="ZeroWallet" type="button">صفر</button>
                            </div>
                        </div>
                        <div class="col-12 text-center">
                            <button class="btn btn-primary me-sm-3 me-1" type="button" id="SaveDeposit">ثبت</button>
                            <button aria-label="بستن" class="btn btn-label-secondary" data-bs-dismiss="modal" type="reset">لغو</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

