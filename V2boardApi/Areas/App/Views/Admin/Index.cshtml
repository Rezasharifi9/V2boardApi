@section customScripts {

    <script>
        window.PanelUserRole = '@(ViewBag.UserRole ?? string.Empty)';
    </script>
    <script src="@PanelAssetHelper.Js("../../assets/js/app-user-list.js")"></script>
    <script src="~/assets/vendor/libs/jquery-form/jquery.form.js"></script>

    <script>

        // اضافه کردن یک event listener برای رویداد hidden.bs.offcanvas
        var offcanvasElement = document.getElementById('offcanvasAddUser');
        offcanvasElement.addEventListener('hidden.bs.offcanvas', function () {
            console.log('Offcanvas has been closed.');
            // اینجا تابع مورد نظر خود را فراخوانی کنید
            document.getElementById('addNewUserForm').reset();

            $("input[type='hidden']").val("0");


        });




    </script>
}