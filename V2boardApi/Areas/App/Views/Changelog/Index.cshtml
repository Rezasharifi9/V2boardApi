@model V2boardApi.Areas.App.Data.Changelog.PanelChangelogPageViewModel
@{
    ViewBag.Title = "تغییرات نسخه";
}

<h4 class="py-3 mb-2">تغییرات نسخه پنل</h4>
<h6 class="mb-4 text-muted">نسخه فعلی: <span class="badge bg-label-primary">@Model.CurrentVersion</span> | نمایش برای: <span class="badge bg-label-info">@Model.RoleLabel</span></h6>

@if (Model.Versions == null || Model.Versions.Count == 0)
{
    <div class="alert alert-info">تغییری برای نمایش در این بخش ثبت نشده است.</div>
}
else
{
    <div class="row">
        <div class="col-12">
            @foreach (var version in Model.Versions)
            {
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <h5 class="mb-1">نسخه @version.Version</h5>
                            <small class="text-muted">تاریخ انتشار: @version.ReleaseDate</small>
                        </div>
                        @if (version.Version == Model.CurrentVersion)
                        {
                            <span class="badge bg-success">نسخه فعلی</span>
                        }
                    </div>
                    <div class="card-body">
                        <ul class="timeline mb-0">
                            @foreach (var item in version.Items)
                            {
                                <li class="timeline-item timeline-item-transparent pb-4">
                                    <span class="timeline-point timeline-point-primary"></span>
                                    <div class="timeline-event">
                                        <div class="timeline-header mb-1 d-flex justify-content-between align-items-start flex-wrap gap-2">
                                            <h6 class="mb-0">@item.Title</h6>
                                            @if (item.Audience == V2boardApi.Areas.App.Data.Changelog.PanelChangelogAudience.Admin)
                                            {
                                                <span class="badge bg-label-warning">ادمین</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-label-success">نماینده</span>
                                            }
                                        </div>
                                        <p class="mb-0 text-muted">@item.Description</p>
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }
        </div>
    </div>
}
