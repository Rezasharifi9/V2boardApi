@{
    ViewBag.Title = "لاگ ارسال هشدارها";
}

@section vendorStyle {
    <link rel="stylesheet" href="../../assets/vendor/libs/sweetalert2/sweetalert2.css" />
    <link href="../../assets/vendor/libs/datatables-bs5/datatables.bootstrap5.css" rel="stylesheet" />
    <link href="../../assets/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.css" rel="stylesheet" />
    <link href="../../assets/vendor/libs/datatables-buttons-bs5/buttons.bootstrap5.css" rel="stylesheet" />
    <link href="../../assets/libs/flatpickr/flatpickr.css" rel="stylesheet" />
}

<h4 class="py-3 mb-4">لاگ ارسال هشدارها</h4>

<div class="card mb-4">
    <div class="card-header">
        <h5 class="card-title mb-0"><i class="ti ti-bell-ringing me-2"></i>فیلتر هشدارها</h5>
    </div>
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label" for="filterAlertRecipient">گیرنده</label>
                <input type="text" id="filterAlertRecipient" class="form-control" placeholder="نام یا نام کاربری" />
            </div>
            <div class="col-md-3">
                <label class="form-label" for="filterAlertType">نوع هشدار</label>
                <input type="text" id="filterAlertType" class="form-control" placeholder="تسویه، سقف اعتبار و ..." />
            </div>
            <div class="col-md-2">
                <label class="form-label" for="filterAlertStatus">وضعیت ارسال</label>
                <select id="filterAlertStatus" class="form-select">
                    <option value="">همه</option>
                    <option value="1">موفق</option>
                    <option value="0">ناموفق</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label" for="filterAlertFromDate">از تاریخ</label>
                <input type="text" dir="ltr" id="filterAlertFromDate" class="form-control" placeholder="1404/01/01" />
            </div>
            <div class="col-md-2">
                <label class="form-label" for="filterAlertToDate">تا تاریخ</label>
                <input type="text" dir="ltr" id="filterAlertToDate" class="form-control" placeholder="1404/03/01" />
            </div>
            <div class="col-12">
                <button type="button" id="btnApplyAlertLogFilters" class="btn btn-primary me-2">
                    <i class="ti ti-filter me-1"></i>اعمال فیلتر
                </button>
                <button type="button" id="btnClearAlertLogFilters" class="btn btn-label-secondary">
                    پاک کردن
                </button>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-datatable table-responsive pt-0">
        <table class="datatables-alert-logs table">
            <thead>
                <tr>
                    <th></th>
                    <th>گیرنده</th>
                    <th>تاریخ</th>
                    <th>نوع هشدار</th>
                    <th>پیام</th>
                    <th>وضعیت ارسال</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section vendorScripts {
    <script src="../../assets/vendor/libs/sweetalert2/sweetalert2.js"></script>
    <script src="../../assets/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
    <script src="../../assets/vendor/libs/datatables-bs5/i18n/fa.js"></script>
    <script src="@PanelAssetHelper.Js("../../assets/libs/jdate/jdate.js")"></script>
    <script src="@PanelAssetHelper.Js("../../assets/libs/flatpickr/flatpickr-jalali.js")"></script>
    <script src="@PanelAssetHelper.Js("../../assets/libs/flatpickr/l10n/fa.js")"></script>
}

@section customScripts {
    <script src="@PanelAssetHelper.Js("../../assets/js/app-alert-send-logs.js")"></script>
}
