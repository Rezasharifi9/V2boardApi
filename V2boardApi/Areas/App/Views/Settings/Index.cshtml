@model DataLayer.DomainModel.tbServers
@{
    ViewBag.Title = "تنظیمات پنل";
}

@section vendorStyle {
    <link rel="stylesheet" href="../../assets/vendor/libs/sweetalert2/sweetalert2.css" />
}

<h4 class="py-3 mb-4">تنظیمات پنل</h4>

<div class="row g-4">
    <!-- تنظیمات عمومی -->
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0"><i class="ti ti-world me-2"></i>تنظیمات عمومی</h5>
            </div>
            <div class="card-body">
                <form id="generalSettingsForm">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="SubAddress">دامنه Sub</label>
                            <input type="text" dir="ltr" class="form-control" id="SubAddress" name="SubAddress" placeholder="sub.example.com" value="@Model.SubAddress" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="BackupSubAddr">دامنه Sub پشتیبان</label>
                            <input type="text" dir="ltr" class="form-control" id="BackupSubAddr" name="BackupSubAddr" placeholder="backup.example.com" value="@Model.BackupSubAddr" />
                        </div>
                    </div>
                    <div class="mt-4">
                        <button type="button" class="btn btn-primary" id="btnSaveGeneral">
                            <i class="ti ti-device-floppy me-1"></i>ذخیره تنظیمات عمومی
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- ارتباط با MySQL -->
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0"><i class="ti ti-database me-2"></i>ارتباط با سرور MySQL</h5>
            </div>
            <div class="card-body">
                <form id="mysqlSettingsForm">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="ServerAddress">دامنه پنل V2board</label>
                            <input type="text" dir="ltr" class="form-control" id="ServerAddress" name="ServerAddress" placeholder="panel.example.com" value="@Model.ServerAddress" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="ServerIP">آیپی سرور MySQL</label>
                            <input type="text" dir="ltr" class="form-control" id="ServerIP" name="ServerIP" placeholder="192.168.1.1" value="@Model.ServerIP" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="DataBaseName">نام دیتابیس</label>
                            <input type="text" dir="ltr" class="form-control" id="DataBaseName" name="DataBaseName" placeholder="v2board" value="@Model.DataBaseName" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="MysqlUsername">نام کاربری MySQL</label>
                            <input type="text" dir="ltr" class="form-control" id="MysqlUsername" name="Username" placeholder="root" value="@Model.Username" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="MysqlPassword">رمز عبور MySQL</label>
                            <input type="password" dir="ltr" class="form-control" id="MysqlPassword" name="Password" placeholder="********" value="@Model.Password" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="ApiToken_V2board">توکن API V2board</label>
                            <input type="text" dir="ltr" class="form-control" id="ApiToken_V2board" name="ApiToken_V2board" placeholder="api-token" value="@Model.ApiToken_V2board" />
                        </div>
                    </div>
                    <div class="mt-4 d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-primary" id="btnSaveMysql">
                            <i class="ti ti-device-floppy me-1"></i>ذخیره تنظیمات MySQL
                        </button>
                        <button type="button" class="btn btn-label-secondary" id="btnTestMysql">
                            <i class="ti ti-plug-connected me-1"></i>تست سرور MySQL
                        </button>
                    </div>
                    <p class="text-muted small mt-3 mb-0">نکته: پورت 3306 در سرور باید باز باشد.</p>
                </form>
            </div>
        </div>
    </div>

    <!-- تنظیمات ربات -->
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0"><i class="ti ti-robot me-2"></i>تنظیمات ربات</h5>
            </div>
            <div class="card-body">
                <form id="botSettingsForm">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label" for="Robot_ID">آیدی ربات (Username)</label>
                            <input type="text" dir="ltr" class="form-control" id="Robot_ID" name="Robot_ID" placeholder="mybot_bot" value="@Model.Robot_ID" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="Robot_Token">توکن ربات</label>
                            <input type="text" dir="ltr" class="form-control" id="Robot_Token" name="Robot_Token" placeholder="123456:ABC..." value="@Model.Robot_Token" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="BotID">Bot ID (عددی)</label>
                            <input type="number" dir="ltr" class="form-control" id="BotID" name="BotID" placeholder="123456789" value="@Model.BotID" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="AdminTelegramUniqID">شناسه تلگرام ادمین</label>
                            <input type="number" dir="ltr" class="form-control" id="AdminTelegramUniqID" name="AdminTelegramUniqID" placeholder="65845695212" value="@Model.AdminTelegramUniqID" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="AdminUsername">یوزرنیم تلگرام ادمین (پشتیبانی)</label>
                            <input type="text" dir="ltr" class="form-control" id="AdminUsername" name="AdminUsername" placeholder="admin_support" value="@ViewBag.AdminUsername" />
                            <small class="text-muted">بدون @@ وارد کنید — برای نمایش آیدی پشتیبانی به کاربران در ربات.</small>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="Channel_ID">آیدی کانال</label>
                            <input type="text" dir="ltr" class="form-control" id="Channel_ID" name="Channel_ID" placeholder="mychannel" value="@Model.Channel_ID" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="BotbaseAddress">آدرس پایه ربات</label>
                            <input type="text" dir="ltr" class="form-control" id="BotbaseAddress" name="BotbaseAddress" placeholder="https://bot.example.com" value="@Model.BotbaseAddress" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="Discount_Percent">تخفیف (درصد)</label>
                            <input type="number" dir="ltr" class="form-control" id="Discount_Percent" name="Discount_Percent" placeholder="15" value="@Model.Discount_Percent" min="0" max="100" step="0.1" />
                        </div>
                    </div>
                    <div class="mt-4">
                        <button type="button" class="btn btn-primary" id="btnSaveBot">
                            <i class="ti ti-device-floppy me-1"></i>ذخیره تنظیمات ربات
                        </button>
                    </div>
                    <p class="text-muted small mt-3 mb-0">برای دریافت شناسه تلگرام ادمین از ربات getmyid_bot استفاده کنید.</p>
                </form>
            </div>
        </div>
    </div>
</div>

@section vendorScripts {
    <script src="../../assets/vendor/libs/sweetalert2/sweetalert2.js"></script>
}

@section customScripts {
    <script src="@Url.Content(PanelAssetHelper.Js("~/assets/js/app-panel-settings.js"))"></script>
}
