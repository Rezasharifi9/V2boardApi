@{
    var panelRole = V2boardApi.Tools.JwtToken.GetUserRole() ?? "";
    var showAgentFilter = panelRole == "1" || panelRole == "3";
}
@section vendorStyle{

    <link href="../../assets/vendor/libs/node-waves/node-waves.css" rel="stylesheet" />
    <link href="../../assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" rel="stylesheet" />
    <link href="../../assets/vendor/libs/typeahead-js/typeahead.css" rel="stylesheet" />
    <link href="../../assets/vendor/libs/datatables-bs5/datatables.bootstrap5.css" rel="stylesheet" />
    <link href="../../assets/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.css" rel="stylesheet" />
    <link href="../../assets/vendor/libs/datatables-checkboxes-jquery/datatables.checkboxes.css" rel="stylesheet" />
    <link href="../../assets/vendor/libs/datatables-buttons-bs5/buttons.bootstrap5.css" rel="stylesheet" />
    <link rel="stylesheet" href="../../assets/vendor/libs/select2/select2.css" />
    <link rel="stylesheet" href="@Url.Content("~/assets/vendor/libs/@form-validation/form-validation.css")" />
    <link rel="stylesheet" href="../../assets/vendor/libs/sweetalert2/sweetalert2.css" />
    <link href="../../assets/libs/jalali-datepicker/jalalidatepicker.css" rel="stylesheet" />
    <link href="../../assets/libs/flatpickr/flatpickr.css" rel="stylesheet" />
    <link href="../../assets/vendor/libs/toastr/toastr.css" rel="stylesheet" />
}
<style>
    .dt-row {
        min-height: 580px !important;
    }

    /* Custom styles for smaller modal */
    #modal-dialog {
        max-width: 200px; /* Adjust the max-width to make it smaller */
        margin: 1.75rem auto;
    }

    #modal-body {
        display: flex;
        justify-content: center;
        align-items: center;
    }
    /* Ensure the QR code container is centered and responsive */
    #qrcode {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        height: 100%;
    }
    /* Adjust the size of QR Code */
    .qr-code-size {
        width: 200px;
        height: 200px;
    }
</style>


<div class="row g-4 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between">
                    <div class="content-left">
                        <span>کاربران فعال</span>
                        <div class="d-flex align-items-center my-2">
                            <h3 class="mb-0 me-2" id="total_users">...</h3>

                        </div>
                    </div>
                    <div class="avatar"> <span class="avatar-initial rounded bg-label-primary"> <i class="ti ti-users ti-sm"></i> </span> </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between">
                    <div class="content-left">
                        <span>کاربران انلاین</span>
                        <div class="d-flex align-items-center my-2">
                            <h3 class="mb-0 me-2" id="online_users">...</h3>
                            @*<p class="text-danger mb-0">
                                    <bdi>(-14%)</bdi>
                                </p>*@
                        </div>
                        @*<p class="mb-0">آمار هفته قبل</p>*@
                    </div>
                    <div class="avatar"> <span class="avatar-initial rounded bg-label-success"> <i class="ti ti-user-check ti-sm"></i> </span> </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between">
                    <div class="content-left">
                        <span>کاربران افلاین</span>
                        <div class="d-flex align-items-center my-2">
                            <h3 class="mb-0 me-2" id="inactive_users">...</h3>
                            @*<p class="text-success mb-0">
                                    <bdi>(+42%)</bdi>
                                </p>*@
                        </div>
                        @*<p class="mb-0">آمار هفته قبل</p>*@
                    </div>
                    <div class="avatar"> <span class="avatar-initial rounded bg-label-warning"> <i class="ti ti-user-off ti-sm"></i> </span> </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between">
                    <div class="content-left">
                        <span>کاربران مسدود</span>
                        <div class="d-flex align-items-center my-2">
                            <h3 class="mb-0 me-2" id="banned_users">...</h3>
                            @*<p class="text-success mb-0">
                                    <bdi>(+42%)</bdi>
                                </p>*@
                        </div>
                        @*<p class="mb-0">آمار هفته قبل</p>*@
                    </div>
                    <div class="avatar"> <span class="avatar-initial rounded bg-label-danger"> <i class="ti ti-user-cancel ti-sm"></i> </span> </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- فیلترهای اشتراک -->
<div class="card mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            @if (showAgentFilter)
            {
                <div class="col-md-3" id="filterAgentCol">
                    <label class="form-label" for="filterAgentSelect">نماینده</label>
                    <select id="filterAgentSelect" class="select2 form-select">
                        <option value="">@(panelRole == "1" ? "همه نمایندگان" : "همه زیرمجموعه")</option>
                    </select>
                </div>
            }
            <div class="col-md-2">
                <label class="form-label" for="filterFromDate">از تاریخ (ساخت)</label>
                <input type="text" id="filterFromDate" class="form-control" placeholder="1404/01/01" />
            </div>
            <div class="col-md-2">
                <label class="form-label" for="filterToDate">تا تاریخ (ساخت)</label>
                <input type="text" id="filterToDate" class="form-control" placeholder="1404/03/01" />
            </div>
            <div class="col-md-2">
                <label class="form-label" for="filterSortMode">مرتب‌سازی</label>
                <select id="filterSortMode" class="form-select">
                    <option value="">پیش‌فرض</option>
                    <option value="lowVolume">حجم رو به اتمام</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="button" id="btnApplySubscriptionFilters" class="btn btn-primary me-2">
                    <i class="ti ti-filter me-1"></i>اعمال فیلتر
                </button>
                <button type="button" id="btnClearSubscriptionFilters" class="btn btn-label-secondary">
                    پاک کردن
                </button>
            </div>
        </div>
    </div>
</div>

<!-- خلاصه فیلتر -->
<div class="row g-4 mb-4 d-none" id="subscriptionFilterSummary">
    <div class="col-sm-6 col-xl-3">
        <div class="card border shadow-none">
            <div class="card-body py-3">
                <small class="text-muted d-block mb-1">نماینده</small>
                <strong id="summaryAgentName">-</strong>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border shadow-none">
            <div class="card-body py-3">
                <small class="text-muted d-block mb-1">تعداد اشتراک ساخته‌شده</small>
                <strong id="summaryTotalCount" class="text-primary">-</strong>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border shadow-none bg-label-success">
            <div class="card-body py-3">
                <small class="text-muted d-block mb-1" id="summaryAmountLabel">جمع مبلغ</small>
                <strong id="summaryTotalAmount">-</strong>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border shadow-none">
            <div class="card-body py-3">
                <small class="text-muted d-block mb-1">بازه تاریخ</small>
                <strong id="summaryDateRange" class="small">-</strong>
            </div>
        </div>
    </div>
</div>

<!-- DataTable with Buttons -->
<div class="card">
    <div class="card-datatable table-responsive pt-0">
        <button style="z-index:1; float: left; margin-top: 16px; margin-left: 17px;" class="btn btn-secondary add-new btn-primary waves-effect waves-light" tabindex="0" data-bs-target="#modalCenter" data-bs-toggle="modal" type="button"><span><i class="ti ti-plus me-0 me-sm-1 ti-xs"></i><span class="d-none d-sm-inline-block">افزودن اشتراک</span></span></button>
        <table class="datatables-plan table">
            <thead>
                <tr>
                    <th></th>
                    <th>نام اشتراک</th>
                    <th>حجم کل</th>
                    <th>حجم مصرف شده</th>
                    <th>حجم باقی مانده</th>
                    <th>روز های باقی مانده</th>
                    <th>کاربران انلاین</th>
                    <th>تعرفه</th>
                    <th>تاریخ انقضا</th>
                    <th>وضعیت</th>
                    <th>عملیات</th>
                </tr>
            </thead>
        </table>
    </div>
</div>


<!-- افزودن اشتراک جدید -->
<div aria-hidden="true" class="modal fade" id="modalCenter" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content section-block">
            <div class="modal-header">
                <h5 class="modal-title" id="modalCenterTitle">افزودن اشتراک</h5>
                <button aria-label="بستن" class="btn-close" data-bs-dismiss="modal" type="button"></button>
            </div>
            <form class="add-new-user pt-0" id="addNewUserForm">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row">
                        <div class="mb-3">
                            <label class="form-label" for="userSubname">نام اشتراک<span class="text-danger"> * </span></label>
                            <input type="text" id="userSubname" class="form-control" placeholder="amir" aria-label="amir"
                                   name="userSubname" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="userPlan">تعرفه<span class="text-danger"> * </span></label>
                            <select id="userPlan" class="select2 form-select userPlan" autocomplete="off" name="userPlan">
                            </select>
                            <div id="userPlanMessage" class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback d-none"><div data-field="userPlanMessage" data-validator="notEmpty">تعرفه را انتخاب کنید</div></div>

                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-label-secondary" data-bs-dismiss="modal" type="button"> بستن</button>
                    <button class="btn btn-primary" type="submit">ذخیره</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!--ویرایش اشتراک-->
<div aria-hidden="true" class="modal fade" id="modalEditSub" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content section-block">
            <div class="modal-header">
                <h5 class="modal-title" id="modalCenterTitle">ویرایش اشتراک</h5>
                <button aria-label="بستن" class="btn-close" data-bs-dismiss="modal" type="button"></button>
            </div>
            <form class="add-new-user pt-0" id="EditUserForm">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" value="" id="user_id" name="user_id" />
                    <div class="row">
                        <div class="mb-3">
                            <label class="form-label" for="userSubname">نام اشتراک<span class="text-danger"> * </span></label>
                            <input type="text" id="userSubname" class="form-control" placeholder="amir" aria-label="amir"
                                   name="userSubname" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="userTraffic">ترافیک (گیگ)<span class="text-danger"> * </span></label>
                            <input type="text" id="userTraffic" class="form-control" placeholder="100" aria-label="100"
                                   name="userTraffic" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="userSpeed">محدودیت سرعت (مگابیت)<span class="text-danger"> * </span></label>
                            <input type="text" id="userSpeed" class="form-control" placeholder="2" aria-label="2"
                                   name="userSpeed" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="expire-picker">تاریخ انقضا<span class="text-danger"> * </span></label>
                            <input class="form-control" id="expire-picker" placeholder="1402/01/01" type="text" name="userExpire" />

                        </div>

                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-label-secondary" data-bs-dismiss="modal" type="button"> بستن</button>
                    <button class="btn btn-primary" type="submit">ذخیره</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!--QR Code اشتراک-->
<div aria-hidden="true" class="modal fade" id="modalQrCode" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered" id="#modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header" style="justify-content:center;">
                <h5 class="modal-title" id="exampleModalLabel2">QR Code</h5>
                <button aria-label="Close" class="btn-close" data-bs-dismiss="modal" type="button"></button>
            </div>
            <div class="modal-body" id="#modal-body">
                <div id="qrcode" class="qr-code-size"></div>
            </div>
        </div>
    </div>
</div>

<!--تمدید اشتراک-->
<div aria-hidden="true" class="modal fade" tabindex="-1" id="modalRenew">
    <div class="modal-dialog modal-dialog-centered" id="#modal-dialog" role="document">
        <div class="modal-content modal-sm section-block">
            <div class="modal-header" style="justify-content:center;">
                <h5 class="modal-title" id="exampleModalLabel2">تمدید اشتراک</h5>
                <button aria-label="Close" class="btn-close" data-bs-dismiss="modal" type="button"></button>
            </div>
            <div class="modal-body">
                <form class="add-new-user pt-0" id="RenewUserForm">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <input type="hidden" value="" id="user_id" name="user_id" />
                        <div class="row">
                            <div class="mb-3">
                                <label class="form-label" for="userPlan">تعرفه<span class="text-danger"> * </span></label>
                                <select id="userPlanRenew" class="select2 form-select userPlan" autocomplete="off" name="userPlan">
                                </select>
                                <div id="userPlanMessage" class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback d-none"><div data-field="userPlanMessage" data-validator="notEmpty">تعرفه را انتخاب کنید</div></div>

                            </div>

                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-label-secondary" data-bs-dismiss="modal" type="button"> بستن</button>
                        <button class="btn btn-primary" type="submit">تمدید</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!--بسته‌های اشتراک-->
<div aria-hidden="true" class="modal fade" tabindex="-1" id="modalPackages">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">بسته‌های اشتراک <span id="packagesSubName" class="text-primary"></span></h5>
                <button aria-label="Close" class="btn-close" data-bs-dismiss="modal" type="button"></button>
            </div>
            <div class="modal-body">
                <form id="packagesActionForm" class="d-none">
                    @Html.AntiForgeryToken()
                </form>
                <h6 class="mb-2">بسته فعال</h6>
                <div class="table-responsive mb-4">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>تعرفه</th>
                                <th>حجم کل (GB)</th>
                                <th>باقی‌مانده (GB)</th>
                                <th>انقضا</th>
                                <th>وضعیت</th>
                            </tr>
                        </thead>
                        <tbody id="packagesCurrentBody"></tbody>
                    </table>
                </div>
                <h6 class="mb-2">بسته‌های رزرو شده</h6>
                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>تعرفه</th>
                                <th>حجم (GB)</th>
                                <th>مدت (ماه)</th>
                                <th>تاریخ رزرو</th>
                                <th>وضعیت</th>
                                <th>عملیات</th>
                            </tr>
                        </thead>
                        <tbody id="packagesReservedBody"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!--تغییر نام-->
<div aria-hidden="true" class="modal fade" tabindex="-1" id="modalChangeName">
    <div class="modal-dialog modal-dialog-centered" id="#modal-dialog" role="document">
        <div class="modal-content modal-sm section-block">
            <div class="modal-header" style="justify-content:center;">
                <h5 class="modal-title" id="exampleModalLabel2">تغییر نام اشتراک</h5>
                <button aria-label="Close" class="btn-close" data-bs-dismiss="modal" type="button"></button>
            </div>
            <div class="modal-body">
                <form class="add-new-user pt-0" id="ChangeNameUserForm">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <input type="hidden" value="" id="user_id" name="user_id" />
                        <input type="hidden" value="" id="OldName" name="OldName" />
                        <div class="row">
                            <div class="mb-3">
                                <label class="form-label" for="SubName">نام جدید<span class="text-danger"> * </span></label>
                                <input type="text" id="SubName" class="form-control" placeholder="" aria-label=""
                                       name="SubName" />
                            </div>

                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-label-secondary" data-bs-dismiss="modal" type="button"> بستن</button>
                        <button class="btn btn-primary" type="submit">ذخیره</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- تاریخچه مصرف کاربر -->
<div aria-hidden="true" class="modal fade" id="modalHistoryUse" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-xl" role="document">
        <div class="modal-content section-block">
            <div class="modal-header">
                <h5 class="modal-title mb-0">تاریخچه مصرف <span id="usageHistoryUserName" class="text-primary"></span></h5>
                <button aria-label="بستن" class="btn-close" data-bs-dismiss="modal" type="button"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3 mb-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label" for="usageHistoryFromDate">از تاریخ</label>
                        <input type="text" id="usageHistoryFromDate" class="form-control" placeholder="1404/01/01" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="usageHistoryToDate">تا تاریخ</label>
                        <input type="text" id="usageHistoryToDate" class="form-control" placeholder="1404/03/01" />
                    </div>
                    <div class="col-md-3">
                        <button type="button" id="btnSearchUsageHistory" class="btn btn-primary w-100">
                            <i class="ti ti-search me-1"></i>جستجو
                        </button>
                    </div>
                    <div class="col-md-3">
                        <button type="button" id="btnExportUsageHistoryPdf" class="btn btn-label-secondary w-100">
                            <i class="ti ti-file-download me-1"></i>خروجی PDF
                        </button>
                    </div>
                </div>
                <div id="usageHistorySummary" class="row g-3 mb-3 d-none">
                    <div class="col-sm-6 col-lg-3">
                        <div class="card border shadow-none">
                            <div class="card-body py-3">
                                <small class="text-muted d-block mb-1">مجموع دانلود</small>
                                <strong id="usageSummaryDownload">-</strong>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <div class="card border shadow-none">
                            <div class="card-body py-3">
                                <small class="text-muted d-block mb-1">مجموع آپلود</small>
                                <strong id="usageSummaryUpload">-</strong>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <div class="card border shadow-none bg-label-primary">
                            <div class="card-body py-3">
                                <small class="text-muted d-block mb-1">مجموع مصرف</small>
                                <strong id="usageSummaryTotal" class="text-primary">-</strong>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <div class="card border shadow-none">
                            <div class="card-body py-3">
                                <small class="text-muted d-block mb-1">بازه جستجو</small>
                                <strong id="usageSummaryRange" class="small">-</strong>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-datatable table-responsive">
                    <table class="usage-history-table table border-top">
                        <thead>
                            <tr>
                                <th>تاریخ</th>
                                <th>دانلود</th>
                                <th>آپلود</th>
                                <th>مجموع</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>



@section vendorScripts {

    <script src="../../assets/vendor/libs/select2/select2.js"></script>
    <script src="../../assets/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
    <script src="../../assets/vendor/libs/datatables-bs5/i18n/fa.js"></script>
    <script src="../../assets/vendor/libs/popper/popper.js"></script>

    <!-- Form Validation -->
    <script src="@Url.Content("~/assets/vendor/libs/@form-validation/popular.js")"></script>
    <script src="@Url.Content("~/assets/vendor/libs/@form-validation/bootstrap5.js")"></script>
    <script src="@Url.Content("~/assets/vendor/libs/@form-validation/auto-focus.js")"></script>
    <script src="../../assets/vendor/libs/hammer/hammer.js"></script>
    <script src="../../assets/vendor/libs/sweetalert2/sweetalert2.js"></script>
    <script src="../../assets/vendor/libs/block-ui/block-ui.js"></script>


    <!-- Date Picker-->
    <script src="@PanelAssetHelper.Js("../../assets/libs/jdate/jdate.js")"></script>
    <script src="@PanelAssetHelper.Js("../../assets/libs/flatpickr/flatpickr-jalali.js")"></script>
    <script src="@PanelAssetHelper.Js("../../assets/libs/flatpickr/l10n/fa.js")"></script>
    <script src="../../assets/vendor/libs/toastr/toastr.js"></script>


}

@section customScripts {

    <script>
        window.UserRole = '@panelRole';
        window.ShowAgentFilter = @(showAgentFilter ? "true" : "false");
    </script>

    <script>

        // نمایش اطلاعات کلی کاربران
        $(function () {

            $.ajax({
                url: "@Url.Action("GetActivityUsers", "Subscriptions", new { area = "App" })",
                type: "GET",
                async: true,
                dataType: "json",
                success: function (res) {
                    console.log(res);

                    if (res.status == "success") {
                        $("#total_users").html(res.data.total_users);
                        $("#online_users").html(res.data.online_users);
                        $("#banned_users").html(res.data.banned_users);
                        $("#inactive_users").html(res.data.inactive_users);
                    }
                },
                error: function (xhr, status, error) {
                    console.error("An error occurred: " + status + " - " + error);
                }
            });

        });


        function generateQRCode(link) {

            $(".dtr-bs-modal").modal("hide");

            // Clear previous QR Code
            document.getElementById("qrcode").innerHTML = "";
            // Create new QR Code
            new QRCode(document.getElementById("qrcode"), {
                text: link,
                width: 200,
                height: 200
            });
        }

        function ShowQRCode(link) {
            generateQRCode(link);
            $("#modalQrCode").modal("show");
        }

        $("#qrcode").click(function () {

            copyToClipboard($(this).attr("title"));

        });

        function GetUsersSelectForSubscriptions(selectId) {
            var $select = $(selectId);
            $.ajax({
                url: '/App/Admin/GetUsersSelect',
                type: 'get',
                dataType: 'json',
                async: true,
                success: function (res) {
                    $select.find('option:not(:first)').remove();
                    if (res && res.data && res.data.length) {
                        $.each(res.data, function (index, item) {
                            $select.append(new Option(item.username, item.id, false, false));
                        });
                    }
                    $select.trigger('change');
                },
                error: function (xhr, status, error) {
                    console.error('خطا در دریافت لیست نمایندگان: ' + status + ' ' + error);
                }
            });
        }

    </script>


    <script src="@Url.Content(PanelAssetHelper.Js("~/assets/libs/qrcode/qrcode.min.js"))"></script>
    <script src="@PanelAssetHelper.Js("../../assets/js/app-subscriptions-list.js")"></script>
}