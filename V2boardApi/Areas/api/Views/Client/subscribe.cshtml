                    </svg><span>ویندوز</span>
                </a>
                <a href="@Url.Action("linux","Client",new { area = "api", token = Model.SubLink })"
                   class="flex-col gap-5 border-2 border-primary dark:border-primary-dark bg dark:bg-primary-dark-fade dark:bg-zinc-800 rounded-lg flex justify-center items-center w-full aspect-square">
                    <svg width="60" height="61" viewBox="0 0 60 61" fill="none" xmlns="http://www.w3.org/2000/svg" class="text-primary">
